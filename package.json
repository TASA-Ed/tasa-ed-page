    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
